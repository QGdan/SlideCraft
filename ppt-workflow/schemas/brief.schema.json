{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppt-workflow:brief:0.1",
  "title": "PPT task brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "topic", "audience", "language", "delivery_mode", "slide_count", "aspect_ratio", "sources", "required_native_types"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "job_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
    "topic": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "language": {"enum": ["zh-CN", "en", "zh-CN-en"]},
    "delivery_mode": {"enum": ["presented", "read_alone"]},
    "slide_count": {"type": "integer", "minimum": 8, "maximum": 20},
    "aspect_ratio": {"const": "16:9"},
    "duration_minutes": {"type": "number", "exclusiveMinimum": 0},
    "theme": {"enum": ["academic", "business", "technical", "provided_template"]},
    "template_path": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "required_native_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "chart", "table", "diagram"]}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [{"if": {"required": ["theme"], "properties": {"theme": {"const": "provided_template"}}}, "then": {"required": ["template_path"]}}],
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "locator", "is_demo"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
        "kind": {"enum": ["file", "url", "inline", "demo"]},
        "locator": {"type": "string", "minLength": 1},
        "is_demo": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "demo"}}}, "then": {"properties": {"is_demo": {"const": true}}}}]
    }
  }
}
