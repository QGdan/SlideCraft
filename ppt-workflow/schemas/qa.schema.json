{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppt-workflow:qa:0.1",
  "title": "QA evidence and delivery status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "revision",
    "created_at",
    "status",
    "artifact",
    "stages",
    "coverage",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "needs_review",
        "unverified"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "geometry",
        "typography",
        "content",
        "render",
        "visual",
        "editability"
      ],
      "properties": {
        "package": {
          "$ref": "#/$defs/stage"
        },
        "geometry": {
          "$ref": "#/$defs/stage"
        },
        "typography": {
          "$ref": "#/$defs/stage"
        },
        "content": {
          "$ref": "#/$defs/stage"
        },
        "render": {
          "$ref": "#/$defs/stage"
        },
        "visual": {
          "$ref": "#/$defs/stage"
        },
        "editability": {
          "$ref": "#/$defs/stage"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated",
        "unknown"
      ],
      "properties": {
        "evaluated": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "unverified",
            "skipped"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unverified",
                  "skipped",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "severity",
        "message",
        "slide_id",
        "element_id",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "slide_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "element_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "suggested_fix": {
          "type": "string"
        },
        "bbox_in": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "details": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "stages": {
            "properties": {
              "package": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "geometry": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "typography": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "content": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "render": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "visual": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "editability": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              }
            }
          },
          "coverage": {
            "properties": {
              "unknown": {
                "maxItems": 0
              }
            }
          },
          "issues": {
            "items": {
              "properties": {
                "severity": {
                  "enum": [
                    "warning",
                    "info"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}