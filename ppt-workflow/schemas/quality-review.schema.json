{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "quality-review/1"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deck_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qa_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "slide": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "slide",
              "sha256"
            ]
          },
          "minItems": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "deck_sha256",
        "spec_sha256",
        "qa_sha256",
        "images"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "needs_review",
                "unverified"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "notes"
          ]
        },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "needs_review",
                "unverified"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "notes"
          ]
        },
        "engineering": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "needs_review",
                "unverified"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "notes"
          ]
        }
      },
      "required": [
        "content",
        "design",
        "engineering"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slide_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "element_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimension": {
            "enum": [
              "content",
              "design",
              "engineering"
            ]
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "owner_stage": {
            "enum": [
              "outline",
              "template",
              "compose",
              "polish",
              "review"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "proposed_fix": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "slide_id",
          "element_id",
          "dimension",
          "severity",
          "owner_stage",
          "issue",
          "evidence",
          "proposed_fix",
          "status",
          "resolution_evidence"
        ]
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slide_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "enum": [
              "yes",
              "no",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "slide_id",
          "question",
          "answer",
          "evidence"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "binding",
    "dimensions",
    "findings",
    "checks"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppt-workflow:quality-review:1"
}