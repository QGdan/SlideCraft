{
  "version": 1,
  "stages": [
    {
      "command": "intake",
      "skill": "ppt-intake",
      "label": "需求访谈",
      "requires": [],
      "output": "requirements.json"
    },
    {
      "command": "outline",
      "skill": "ppt-outline",
      "label": "资料与大纲",
      "requires": [
        "intake"
      ],
      "output": "content-outline.json"
    },
    {
      "command": "template",
      "skill": "ppt-template",
      "label": "模板选择与创建",
      "requires": [
        "outline"
      ],
      "output": "template-selection.json"
    },
    {
      "command": "compose",
      "skill": "ppt-compose",
      "label": "制作与修改",
      "requires": [
        "template"
      ],
      "output": "composition.json"
    },
    {
      "command": "polish",
      "skill": "ppt-polish",
      "label": "美化与润色",
      "requires": [
        "compose"
      ],
      "output": "polish-report.json"
    },
    {
      "command": "review",
      "skill": "ppt-review",
      "label": "效果审核",
      "requires": [
        "polish"
      ],
      "output": "review-report.json"
    }
  ],
